{
  "name": "curio",
  "version": "1.0.0",
  "description": "Curio — Universal In-Situ AI Browser Extension",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.js",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.js",
    "package": "node scripts/package-extension.js",
    "server": "node backend/src/server.js",
    "server:dev": "node --watch backend/src/server.js",
    "backend:install": "npm --prefix backend install"
  },
  "workspaces": [
    "backend"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.1"
  }
}
