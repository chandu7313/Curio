# ─────────────────────────────────────────────────────────────────────────────
# Curio Backend — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────

# Server Port (Default: 3000 to avoid macOS AirPlay Receiver on port 5000)
PORT=3000
NODE_ENV=development

# AI Provider Configuration
# Supported providers: gemini | groq
DEFAULT_AI_PROVIDER=gemini
ENABLE_PROVIDER_FAILOVER=true

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq API
# Get your API key from Groq Console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Database Connection URL (Optional for AI explanations, required for cloud sync)
DATABASE_URL=postgresql://curio:curio_secret@localhost:5432/curio_db
DB_POOL_MAX=20

# CORS Origins (Comma-separated list of web origins allowed to access the API)
# chrome-extension:// origins are allowed automatically
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
